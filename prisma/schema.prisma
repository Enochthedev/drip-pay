// Prisma schema for DripPay subscription platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  address   String   @unique // Wallet address
  email     String?  @unique
  nonce     String   @default(uuid()) // For wallet authentication
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions   Subscription[]
  subscriptionPlans SubscriptionPlan[]
  payments        Payment[]
  webhooks        Webhook[]

  @@index([address])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       String   // Store as string to handle big numbers
  currency    String   // Token symbol (USDC, USDT, etc)
  interval    String   // daily, weekly, monthly, yearly
  chainId     Int
  tokenAddress String  // ERC20 token contract address
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User     @relation(fields: [creatorId], references: [id])
  creatorId   String

  subscriptions Subscription[]

  @@index([creatorId])
  @@index([chainId])
}

model Subscription {
  id                String   @id @default(cuid())
  status            String   // active, paused, cancelled, expired
  startDate         DateTime
  nextBillingDate   DateTime?
  endDate           DateTime?
  chainId           Int
  contractAddress   String?  // Smart contract managing this subscription
  subscriptionId    String?  // On-chain subscription ID
  lastPaymentDate   DateTime?
  failedPayments    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  planId            String

  subscriber        User     @relation(fields: [subscriberId], references: [id])
  subscriberId      String

  payments          Payment[]
  events            SubscriptionEvent[]

  @@index([subscriberId])
  @@index([planId])
  @@index([status])
  @@index([chainId])
}

model Payment {
  id              String   @id @default(cuid())
  amount          String   // Store as string to handle big numbers
  currency        String
  status          String   // pending, completed, failed
  txHash          String?  @unique // Blockchain transaction hash
  blockNumber     Int?
  chainId         Int
  tokenAddress    String
  fromAddress     String
  toAddress       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?

  user            User     @relation(fields: [userId], references: [id])
  userId          String

  @@index([txHash])
  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
}

model SubscriptionEvent {
  id              String   @id @default(cuid())
  eventType       String   // created, renewed, cancelled, paused, resumed, payment_failed
  txHash          String?
  blockNumber     Int?
  chainId         Int?
  metadata        Json?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String

  @@index([subscriptionId])
  @@index([eventType])
}

model Webhook {
  id              String   @id @default(cuid())
  url             String
  events          String[] // Array of event types to listen for
  secret          String   // HMAC secret for webhook verification
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  userId          String

  deliveries      WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  eventType       String
  payload         Json
  status          String   // pending, success, failed
  statusCode      Int?
  response        String?
  attempts        Int      @default(0)
  nextRetry       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  webhook         Webhook  @relation(fields: [webhookId], references: [id])
  webhookId       String

  @@index([webhookId])
  @@index([status])
}

model BlockchainSync {
  id              String   @id @default(cuid())
  chainId         Int      @unique
  lastSyncedBlock Int
  contractAddress String
  syncStatus      String   // syncing, synced, error
  lastSyncedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([chainId])
}
